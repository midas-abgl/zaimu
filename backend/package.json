{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/main.ts --target bun --outdir ./dist",
		"dev": "bun --watch src/main.ts",
		"migrate": "prisma migrate dev --create-only",
		"migrate:deploy": "prisma migrate deploy",
		"migrate:dev": "prisma migrate dev",
		"prepare": "prisma generate",
		"seed": "prisma db seed",
		"start": "NODE_ENV=production bun dist/main.js",
		"test": "bun test"
	},
	"dependencies": {
		"@elysiajs/bearer": "^1.4.2",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/jwt": "^1.4.0",
		"@elysiajs/openapi": "^1.4.14",
		"@prisma/adapter-pg": "^6.13.0",
		"cron-validate": "^1.5.2",
		"date-fns": "^4.1.0",
		"elysia": "^1.4.28",
		"jose": "^6.1.3",
		"kysely": "^0.28.4",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.31",
		"@prisma/client": "^6.13.0",
		"@types/bun": "^1.3.12",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.15.5",
		"dotenv": "^17.2.1",
		"http-status-codes": "^2.3.0",
		"prisma": "^6.13.0",
		"prisma-kysely": "^1.8.0",
		"typescript": "^6.0.2"
	}
}
