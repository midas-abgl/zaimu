{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"main": "main.ts",
	"scripts": {
		"build": "bun build --minify --outdir=../build --target bun ./src/main.ts",
		"dev": "bun run --watch ./src/main.ts",
		"migrate": "prisma migrate dev --create-only",
		"migrate:deploy": "prisma migrate deploy",
		"migrate:dev": "prisma migrate dev",
		"prepare": "prisma generate",
		"seed": "prisma db seed",
		"start": "NODE_ENV=production bun ./src/main.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/swagger": "^1.3.1",
		"@hyoretsu/providers": "^1.4.0",
		"@prisma/adapter-pg": "^6.13.0",
		"cron-validate": "^1.5.2",
		"date-fns": "^4.1.0",
		"elysia": "^1.3.8",
		"kysely": "^0.28.4",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@hyoretsu/tsconfig": "^2.1.1",
		"@prisma/client": "^6.13.0",
		"@types/date-fns": "^2.6.3",
		"@types/pg": "^8.15.5",
		"dotenv": "^17.2.1",
		"http-status-codes": "^2.3.0",
		"jiti": "^2.5.1",
		"prisma": "^6.13.0",
		"prisma-kysely": "^1.8.0"
	}
}
