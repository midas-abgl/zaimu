{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/main.ts --target bun --outdir ./dist",
		"check-types": "tsc --noEmit",
		"dev": "bun --watch src/main.ts",
		"start": "NODE_ENV=production bun dist/main.js",
		"test": "bun test",
		"test:e2e": "bun run tests/run-e2e.ts",
		"test:unit": "bun test src"
	},
	"dependencies": {
		"@elysiajs/bearer": "^1.4.2",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/jwt": "^1.4.0",
		"@elysiajs/openapi": "^1.4.14",
		"better-auth": "^1.7.1",
		"cron-validate": "^1.5.2",
		"date-fns": "^4.1.0",
		"elysia": "^1.4.28",
		"jose": "^6.1.3",
		"nodemailer": "^9.0.5",
		"sql": "workspace:*"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.31",
		"@types/bun": "^1.3.12",
		"@types/node": "^25.6.0",
		"@types/nodemailer": "^8.0.1",
		"dotenv": "^17.2.1",
		"http-status-codes": "^2.3.0",
		"typescript": "^6.0.2"
	}
}
