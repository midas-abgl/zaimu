model Transaction {
    id            String            @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    amount        Decimal           @db.Decimal(12, 2)
    date          DateTime          @db.Date
    description   String?           @db.VarChar(1000)
    type          TransactionType   @default(EXPENSE)
    categoryId    String?           @db.VarChar(36)
    category      Category?         @relation(fields: [categoryId], references: [id])
    recurrenceId  String?           @db.VarChar(36)
    recurrence    RecurringPayment? @relation(fields: [recurrenceId], references: [id])
    originFinancialAccountId      String?           @db.VarChar(36)
    origin        FinancialAccount?          @relation("Transaction_origin", fields: [originFinancialAccountId], references: [id], onDelete: SetNull)
    destinationFinancialAccountId String?           @db.VarChar(36)
    destination   FinancialAccount?          @relation("Transaction_destination", fields: [destinationFinancialAccountId], references: [id], onDelete: SetNull)
    createdAt     DateTime          @default(now())
    updatedAt     DateTime          @default(now()) @updatedAt

    history TransactionHistory[]
}

enum TransactionType {
    INCOME
    EXPENSE
    TRANSFER
}

model TransactionHistory {
    id            String      @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    transactionId String      @db.VarChar(36)
    transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    field         String      @db.VarChar(50)
    oldValue      String?
    newValue      String?
    changedAt     DateTime    @default(now())
}

model Category {
    id        String     @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    userId    String     @db.VarChar(36)
    user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    name      String     @db.VarChar(50)
    color     String?    @db.VarChar(7)
    icon      String?    @db.VarChar(50)
    parentId  String?    @db.VarChar(36)
    parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
    children  Category[] @relation("CategoryHierarchy")
    createdAt DateTime   @default(now())
    updatedAt DateTime   @default(now()) @updatedAt

    transactions      Transaction[]
    creditPurchases   CreditPurchase[]
    recurringPayments RecurringPayment[]

    @@unique([userId, name])
}

model RecurringPayment {
    id            String              @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    userId        String              @db.VarChar(36)
    name          String              @db.VarChar(100)
    amount        Decimal             @db.Decimal(12, 2)
    frequency     RecurrenceFrequency
    dayOfMonth    Int?                @db.SmallInt
    dayOfWeek     Int?                @db.SmallInt
    startDate     DateTime            @db.Date
    endDate       DateTime?           @db.Date
    categoryId    String?             @db.VarChar(36)
    category      Category?           @relation(fields: [categoryId], references: [id])
    paymentMethod PaymentMethod       @default(DEBIT)
    isActive      Boolean             @default(true)
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @default(now()) @updatedAt

    transactions Transaction[]
    history      RecurringPaymentHistory[]
}

enum RecurrenceFrequency {
    DAILY
    WEEKLY
    BIWEEKLY
    MONTHLY
    YEARLY
}

enum PaymentMethod {
    DEBIT
    CREDIT
    PIX
    CASH
    TRANSFER
    BOLETO
}

model RecurringPaymentHistory {
    id                 String           @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    recurringPaymentId String           @db.VarChar(36)
    recurringPayment   RecurringPayment @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)
    field              String           @db.VarChar(50)
    oldValue           String?
    newValue           String?
    changedAt          DateTime         @default(now())
}

model Salary {
    id          String              @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    userId      String              @db.VarChar(36)
    user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    source      String              @db.VarChar(100)
    grossAmount Decimal             @db.Decimal(12, 2)
    netAmount   Decimal             @db.Decimal(12, 2)
    frequency   RecurrenceFrequency @default(MONTHLY)
    payDay      Int                 @db.SmallInt
    startDate   DateTime            @db.Date
    endDate     DateTime?           @db.Date
    isActive    Boolean             @default(true)
    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @default(now()) @updatedAt

    payments SalaryPayment[]
    history  SalaryHistory[]
}

model SalaryPayment {
    id        String   @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    salaryId  String   @db.VarChar(36)
    salary    Salary   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
    financialAccountId String           @db.VarChar(36)
    financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
    amount    Decimal  @db.Decimal(12, 2)
    date      DateTime @db.Date
    notes     String?  @db.VarChar(500)
    createdAt DateTime @default(now())
}

model SalaryHistory {
    id        String   @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    salaryId  String   @db.VarChar(36)
    salary    Salary   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
    field     String   @db.VarChar(50)
    oldValue  String?
    newValue  String?
    changedAt DateTime @default(now())
}

model Debt {
    id          String    @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    userId      String    @db.VarChar(36)
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    personName  String    @db.VarChar(100)
    amount      Decimal   @db.Decimal(12, 2)
    description String?   @db.VarChar(500)
    isOwedToMe  Boolean   @default(true)
    date        DateTime  @db.Date
    dueDate     DateTime? @db.Date
    isPaid      Boolean   @default(false)
    paidDate    DateTime? @db.Date
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @default(now()) @updatedAt

    history DebtHistory[]
}

model DebtHistory {
    id        String   @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    debtId    String   @db.VarChar(36)
    debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
    field     String   @db.VarChar(50)
    oldValue  String?
    newValue  String?
    changedAt DateTime @default(now())
}

model Subscription {
    id            String              @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    userId        String              @db.VarChar(36)
    user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    name          String              @db.VarChar(100)
    amount        Decimal             @db.Decimal(12, 2)
    billingDay    Int                 @db.SmallInt
    frequency     RecurrenceFrequency @default(MONTHLY)
    paymentMethod PaymentMethod       @default(CREDIT)
    startDate     DateTime            @db.Date
    endDate       DateTime?           @db.Date
    isActive      Boolean             @default(true)
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @default(now()) @updatedAt

    history SubscriptionHistory[]
}

model SubscriptionHistory {
    id             String       @id @default(dbgenerated("cuid2()")) @db.VarChar(36)
    subscriptionId String       @db.VarChar(36)
    subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    field          String       @db.VarChar(50)
    oldValue       String?
    newValue       String?
    changedAt      DateTime     @default(now())
}
