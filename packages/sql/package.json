{
	"name": "sql",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"contract:emit": "prisma-cli contract emit && bunx biome check --write --unsafe src/prisma/contract.d.ts src/prisma/contract.json",
		"db:sign": "prisma-cli db sign",
		"db:verify": "prisma-cli db verify",
		"migrate:deploy": "prisma-cli migrate --advance-ref db",
		"migration:check": "prisma-cli migration check",
		"migration:plan": "prisma-cli migration plan",
		"migration:status": "prisma-cli migration status"
	},
	"dependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.5",
		"dotenv": "^17.4.2",
		"pg": "8.22.0"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.37",
		"@prisma/cli": "8.0.0-rc.7",
		"@prisma/cli-engine": "0.2.0",
		"@types/node": "^25.9.1",
		"@types/pg": "8.20.4",
		"typescript": "^6.0.3"
	}
}
